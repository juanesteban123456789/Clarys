<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_soft_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textCustomerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/clarys_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCustomerPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/clarys_muted" />

    <TextView
        android:id="@+id/textCustomerSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/clarys_mid"
        android:textStyle="bold" />
</LinearLayout>
