<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clarys_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonHeaderHome"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="Inicio"
                android:textAllCaps="false"
                android:textColor="@color/clarys_mid" />

            <Button
                android:id="@+id/buttonHeaderBack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="Atras"
                android:textAllCaps="false"
                android:textColor="@color/clarys_mid" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Movimiento de inventario"
            android:textColor="@color/clarys_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerMovementProduct"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp" />

        <Spinner
            android:id="@+id/spinnerMovementType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp" />

        <EditText
            android:id="@+id/inputMovementQuantity"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Cantidad"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputMovementReason"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="Motivo"
            android:padding="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <Button
            android:id="@+id/buttonApplyMovement"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_primary_button"
            android:text="Registrar movimiento"
            android:textAllCaps="false"
            android:textColor="@color/clarys_light" />

        <Button
            android:id="@+id/buttonCancelMovement"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary_button"
            android:text="Volver a inventario"
            android:textAllCaps="false"
            android:textColor="@color/clarys_mid" />
    </LinearLayout>
</ScrollView>
