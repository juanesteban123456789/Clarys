<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_canvas"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonSQLiteEvidenceBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_header_action"
                android:backgroundTint="@null"
                android:contentDescription="@string/sqlite_evidence_back"
                android:padding="13dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/clarys_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sqlite_evidence_short_title"
                    android:textColor="@color/clarys_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/sqlite_evidence_header_subtitle"
                    android:textColor="@color/clarys_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_login_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/sqlite_evidence_short_title"
                android:src="@drawable/ic_inventory_dark"
                app:tint="@color/clarys_mid" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sqlite_evidence_title"
                android:textColor="@color/clarys_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sqlite_evidence_subtitle"
                android:textColor="@color/clarys_mid"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/sqlite_evidence_notice"
                android:textColor="@color/clarys_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_soft"
                android:padding="12dp"
                android:text="@string/sqlite_evidence_demo_credentials"
                android:textColor="@color/clarys_mid"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/sqlite_evidence_email_label"
                android:textColor="@color/clarys_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputSQLiteEvidenceEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input"
                android:hint="@string/sqlite_evidence_email_hint"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="15dp"
                android:singleLine="true"
                android:textColor="@color/clarys_text"
                android:textColorHint="@color/clarys_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/sqlite_evidence_password_label"
                android:textColor="@color/clarys_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputSQLiteEvidencePassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:autofillHints="password"
                android:background="@drawable/bg_input"
                android:hint="@string/sqlite_evidence_password_hint"
                android:inputType="textPassword"
                android:paddingHorizontal="15dp"
                android:singleLine="true"
                android:textColor="@color/clarys_text"
                android:textColorHint="@color/clarys_muted"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonSQLiteEvidenceValidate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:text="@string/sqlite_evidence_validate"
                android:textAllCaps="false"
                android:textColor="@color/clarys_light"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonSQLiteEvidenceClear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_soft_button"
                android:backgroundTint="@null"
                android:text="@string/sqlite_evidence_clear"
                android:textAllCaps="false"
                android:textColor="@color/clarys_mid"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSQLiteEvidenceResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_soft_card"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/sqlite_evidence_waiting"
                android:textColor="@color/clarys_muted"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
