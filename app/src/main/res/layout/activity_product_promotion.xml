<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/clarys_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonHeaderBack" style="@style/DocumentIcon"
                android:src="@drawable/ic_arrow_back" android:contentDescription="@string/promotion_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingHorizontal="12dp" android:text="@string/promotion_title" android:textSize="18sp"
                android:textStyle="bold" android:textColor="@color/clarys_dark" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonHeaderHome" style="@style/DocumentIcon"
                android:src="@drawable/ic_home" android:contentDescription="@string/promotion_home" />
        </LinearLayout>
        <RadioGroup android:id="@+id/groupPromotionFormat" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp" android:checkedButton="@id/radioPromotionPost">
            <RadioButton android:id="@+id/radioPromotionPost" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/promotion_post" />
            <RadioButton android:id="@+id/radioPromotionStory" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/promotion_story" />
        </RadioGroup>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <CheckBox android:id="@+id/checkPromotionPrice" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true" android:text="@string/promotion_price" />
            <CheckBox android:id="@+id/checkPromotionContact" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true" android:text="@string/promotion_contact" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progressPromotion" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center_horizontal" />
        <ImageView android:id="@+id/imagePromotionPreview" android:layout_width="match_parent" android:layout_height="400dp"
            android:scaleType="fitCenter" android:contentDescription="@string/promotion_preview" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonPromotionRetry" style="@style/DocumentAction"
            android:text="@string/promotion_retry" android:visibility="gone" />
        <TextView style="@style/DocumentHeading" android:text="@string/promotion_caption_label" android:labelFor="@id/inputPromotionCaption" />
        <EditText android:id="@+id/inputPromotionCaption" style="@style/DocumentField"
            android:inputType="textCapSentences|textMultiLine" android:gravity="top|start" android:minLines="4" android:maxLength="2200" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonPromotionReset"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/promotion_reset"
            android:textAllCaps="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false"
            android:paddingBottom="24dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonPromotionCopy" style="@style/DocumentAction"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="88dp" android:textSize="12sp"
                android:drawableTop="@drawable/ic_promotion_copy" android:text="@string/promotion_copy" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonPromotionSave" style="@style/DocumentAction"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="88dp" android:textSize="12sp"
                android:layout_marginHorizontal="6dp" android:drawableTop="@drawable/ic_promotion_download" android:text="@string/promotion_save" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonPromotionShare" style="@style/DocumentAction"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="88dp" android:textSize="12sp"
                android:drawableTop="@drawable/ic_promotion_share" android:text="@string/promotion_share" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
