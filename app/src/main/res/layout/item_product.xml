<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_product_info_card"
    android:orientation="vertical"
    android:padding="16dp">


    <!-- ================================================= -->
    <!-- IMAGEN -->
    <!-- ================================================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_product_image_container">

        <ImageView
            android:id="@+id/imageProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_placeholder"
            android:clipToOutline="true"
            android:contentDescription="Imagen del producto"
            android:scaleType="centerCrop"
            android:visibility="gone" />

    </FrameLayout>


    <!-- ================================================= -->
    <!-- CATEGORÍA + STOCK -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textProductCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/clarys_mid"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textProductStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stock_badge"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/clarys_mid"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- NOMBRE -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/textProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/clarys_dark"
        android:textSize="18sp"
        android:textStyle="bold" />


    <!-- ================================================= -->
    <!-- DESCRIPCIÓN -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/textProductDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/clarys_text"
        android:textSize="13sp" />


    <!-- ================================================= -->
    <!-- INFORMACIÓN EXTRA -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/textProductExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/clarys_muted"
        android:textSize="12sp" />


    <!-- ================================================= -->
    <!-- PRECIO -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_stock_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio"
            android:textColor="@color/clarys_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textProductPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/clarys_mid"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- ACCIONES -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">


        <!-- ACCIÓN PRINCIPAL -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonProductPrimary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_action"
            android:backgroundTint="@null"
            android:drawablePadding="7dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAllCaps="false"
            android:textColor="@color/clarys_mid"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_search"
            app:drawableTint="@color/clarys_mid" />


        <!-- ACCIÓN DESTACADA -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonProductSecondary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_client"
            android:backgroundTint="@null"
            android:drawablePadding="7dp"
            android:elevation="4dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textAllCaps="false"
            android:textColor="@color/clarys_light"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_cart"
            app:drawableTint="@color/clarys_light" />

    </LinearLayout>

</LinearLayout>