<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:orientation="vertical">
    <TextView android:id="@+id/textVariantSummary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/clarys_muted" android:textSize="13sp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonEditVariants"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="8dp" android:background="@drawable/bg_admin_action"
        android:backgroundTint="@null" android:text="Stock por talla y color"
        android:textColor="@color/clarys_dark" android:textAllCaps="false" android:textSize="13sp"
        app:drawableStartCompat="@drawable/ic_inventory" app:drawableTint="@color/clarys_dark" />
</LinearLayout>
