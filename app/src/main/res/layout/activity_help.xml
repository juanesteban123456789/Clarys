<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/clarys_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonHelpBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back" android:background="@drawable/bg_header_action"
            android:contentDescription="Volver" />
        <TextView android:id="@+id/textHelpTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="23sp"
            android:textStyle="bold" android:textColor="@color/clarys_dark" />
        <TextView android:id="@+id/textHelpBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="15sp"
            android:textColor="@color/clarys_text" android:lineSpacingExtra="5dp"
            android:textIsSelectable="true" />
        <TextView android:id="@+id/textHelpVersion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:textSize="12sp" android:textColor="@color/clarys_muted" />
    </LinearLayout>
</ScrollView>
