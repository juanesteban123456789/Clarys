<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clarys_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonHeaderHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Ir al inicio"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_home"
                android:tint="@color/clarys_mid" />

            <ImageButton
                android:id="@+id/buttonHeaderBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Volver atras"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/clarys_mid" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Crear o editar producto"
            android:textColor="@color/clarys_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputProductName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Nombre"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductDescription"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="Descripcion"
            android:padding="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Categoria"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductSku"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="SKU o codigo"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductPurchasePrice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Precio de compra"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductSalePrice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Precio de venta"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductStock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Stock actual"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductMinStock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Stock minimo"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductSizes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Tallas: S, M, L"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputProductColors"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Colores"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <CheckBox
            android:id="@+id/checkProductActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Producto activo"
            android:textColor="@color/clarys_dark" />

        <Button
            android:id="@+id/buttonProductImage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary_button"
            android:backgroundTint="@null"
            android:text="Seleccionar imagen"
            android:textAllCaps="false"
            android:textColor="@color/clarys_mid" />

        <Button
            android:id="@+id/buttonSaveProductForm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Guardar producto"
            android:textAllCaps="false"
            android:textColor="@color/clarys_light" />

        <Button
            android:id="@+id/buttonCancelProductForm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_soft_button"
            android:backgroundTint="@null"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/clarys_mid" />
    </LinearLayout>
</ScrollView>
