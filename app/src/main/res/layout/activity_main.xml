<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_canvas">


    <!-- ================================================= -->
    <!-- CONTENIDO -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/scrollDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="48dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_taller_clarys" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Panel de control"
                        android:textColor="@color/clarys_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Resumen administrativo"
                        android:textColor="@color/clarys_muted"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INTRO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_product_category"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="RESUMEN GENERAL"
                android:textColor="@color/clarys_mid"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Así va tu taller"
                android:textColor="@color/clarys_dark"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Consulta ventas, pedidos, inventario y alertas desde un solo lugar."
                android:textColor="@color/clarys_muted"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- VENTAS -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_action_client"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <FrameLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_action_arrow">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_cart"
                        app:tint="@color/clarys_light" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:text="Ventas"
                        android:textColor="@color/clarys_light"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDashboardSales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:textColor="@color/clarys_light"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:alpha="0.75"
                        android:text="Rendimiento comercial"
                        android:textColor="@color/clarys_light"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PEDIDOS + STOCK -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">


                <!-- PEDIDOS PENDIENTES -->

                <LinearLayout
                    android:id="@+id/buttonPendingOrders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_product_info_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:minHeight="144dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_detail_icon">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_store"
                            app:tint="@color/clarys_mid" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Pedidos pendientes"
                        android:textColor="@color/clarys_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDashboardOrders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/clarys_dark"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Toca para gestionar"
                        android:textColor="@color/clarys_mid"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- STOCK BAJO -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="144dp"
                    android:paddingBottom="18dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stock_badge"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_detail_icon">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/clarys_mid" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Stock bajo"
                        android:textColor="@color/clarys_muted"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDashboardLowStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textColor="@color/clarys_mid"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- VALOR INVENTARIO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_product_info_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_detail_icon">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_inventory"
                        app:tint="@color/clarys_mid" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Valor del inventario"
                        android:textColor="@color/clarys_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDashboardInventoryValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/clarys_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- GRÁFICO -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_product_info_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Actividad del taller"
                            android:textColor="@color/clarys_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Resumen operativo"
                            android:textColor="@color/clarys_muted"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_product_category"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="GRÁFICO"
                        android:textColor="@color/clarys_mid"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.clarys.app.ui.DashboardChartView
                    android:id="@+id/chartDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/textDashboardBestSeller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_stock_badge"
                    android:padding="12dp"
                    android:textColor="@color/clarys_mid"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- MENÚ INFERIOR FIJO -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutDashboardBottomMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">


        <!-- ================================================= -->
        <!-- PANEL QUE SE DESPLIEGA HACIA ARRIBA -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutDashboardMoreOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_bottom_navigation"
            android:elevation="14dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">


            <!-- CABECERA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Más herramientas"
                        android:textColor="@color/clarys_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Administración del taller"
                        android:textColor="@color/clarys_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_product_category"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="MENÚ"
                    android:textColor="@color/clarys_mid"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- CATÁLOGO + CLIENTES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonOpenCatalog"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_action"
                    android:backgroundTint="@null"
                    android:drawablePadding="5dp"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="7dp"
                    android:text="Mi catálogo"
                    android:textAllCaps="false"
                    android:textColor="@color/clarys_mid"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:drawableTopCompat="@drawable/ic_store"
                    app:drawableTint="@color/clarys_mid" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonOpenCustomers"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_action"
                    android:backgroundTint="@null"
                    android:drawablePadding="5dp"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="7dp"
                    android:text="Clientes"
                    android:textAllCaps="false"
                    android:textColor="@color/clarys_mid"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:drawableTopCompat="@drawable/ic_customer"
                    app:drawableTint="@color/clarys_mid" />

            </LinearLayout>


            <!-- AJUSTES -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonOpenSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_admin_action"
                android:backgroundTint="@null"
                android:drawablePadding="9dp"
                android:gravity="center"
                android:text="Ajustes"
                android:textAllCaps="false"
                android:textColor="@color/clarys_mid"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_settings"
                app:drawableTint="@color/clarys_mid" />


            <!-- CERRAR SESIÓN -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_soft_button"
                android:backgroundTint="@null"
                android:drawablePadding="9dp"
                android:gravity="center"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="@color/clarys_mid"
                android:textSize="13sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_lock"
                app:drawableTint="@color/clarys_mid" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DESPLEGAR / CONTRAER -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/buttonToggleDashboardMenu"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_soft_button"
            android:clickable="true"
            android:elevation="7dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/textToggleDashboardMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Más opciones"
                android:textColor="@color/clarys_mid"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iconToggleDashboardMenu"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/clarys_mid" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BARRA FIJA -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_bottom_navigation"
            android:elevation="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp">


            <!-- PRODUCTOS -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonOpenProducts"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_bottom_navigation_active"
                android:backgroundTint="@null"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:text="Productos"
                android:textAllCaps="false"
                android:textColor="@color/clarys_light"
                android:textSize="10sp"
                android:textStyle="bold"
                app:drawableTopCompat="@drawable/ic_store"
                app:drawableTint="@color/clarys_light" />


            <!-- INVENTARIO -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonOpenInventory"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:text="Inventario"
                android:textAllCaps="false"
                android:textColor="@color/clarys_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                app:drawableTopCompat="@drawable/ic_inventory"
                app:drawableTint="@color/clarys_muted" />


            <!-- REPORTES -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonOpenReports"
                android:layout_width="0dp"
                android:layout_height="66dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:backgroundTint="@null"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="4dp"
                android:text="Reportes"
                android:textAllCaps="false"
                android:textColor="@color/clarys_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                app:drawableTopCompat="@drawable/ic_report"
                app:drawableTint="@color/clarys_muted" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>