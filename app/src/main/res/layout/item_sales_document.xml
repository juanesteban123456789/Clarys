<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:paddingVertical="14dp" android:orientation="vertical">
    <TextView android:id="@+id/textDocumentRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/clarys_mid" android:textSize="12sp" />
    <TextView android:id="@+id/textDocumentRowCustomer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/clarys_dark" />
    <TextView android:id="@+id/textDocumentRowDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/clarys_muted" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/textDocumentRowTotal" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/clarys_dark" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonOpenSavedDocument" style="@style/DocumentIcon"
            android:src="@android:drawable/ic_menu_view" android:contentDescription="@string/documents_open" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonDeleteSavedDocument" style="@style/DocumentIcon"
            android:layout_marginStart="6dp" android:src="@android:drawable/ic_menu_delete" android:contentDescription="@string/documents_delete" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#DCE6ED" />
</LinearLayout>
