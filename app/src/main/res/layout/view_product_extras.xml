<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="12dp">
    <TextView android:id="@+id/textDetailVariantStock"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/clarys_muted" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonFavoriteProduct"
            android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/bg_header_action"
            android:src="@android:drawable/btn_star_big_off" android:contentDescription="Guardar favorito" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonShareProduct"
            android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp"
            android:background="@drawable/bg_header_action"
            android:src="@android:drawable/ic_menu_share" android:contentDescription="Compartir producto" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonProductWhatsapp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
            android:layout_marginStart="8dp" android:background="@drawable/bg_whatsapp_button"
            android:backgroundTint="@null" android:text="Consultar" android:textAllCaps="false"
            android:textColor="@color/clarys_light" android:drawableStart="@drawable/ic_whatsapp"
            android:paddingHorizontal="10dp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonDuplicateProduct"
        android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"
        android:text="Duplicar producto" android:textAllCaps="false" android:visibility="gone"
        android:background="@drawable/bg_admin_action" android:backgroundTint="@null"
        android:textColor="@color/clarys_dark" android:drawableStart="@drawable/ic_add_product"
        android:paddingHorizontal="14dp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonPreparePromotion" style="@style/DocumentAction"
        android:layout_marginTop="8dp" android:text="@string/promotion_title" android:visibility="gone"
        android:drawableStart="@drawable/ic_promotion" />
    <TextView android:id="@+id/textRelatedProductsTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Productos relacionados"
        android:textSize="17sp" android:textStyle="bold" android:textColor="@color/clarys_dark" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerRelatedProducts"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</LinearLayout>
