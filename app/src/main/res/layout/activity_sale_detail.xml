<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clarys_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonHeaderHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Ir al inicio"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_home"
                android:tint="@color/clarys_mid" />

            <ImageButton
                android:id="@+id/buttonHeaderBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Volver atras"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/clarys_mid" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textSaleDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/clarys_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSaleDetailCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/clarys_text" />

            <TextView
                android:id="@+id/textSaleDetailStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/clarys_mid"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerSaleDetailItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textSaleDetailTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/clarys_dark"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonNewSaleFromDetail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Nueva venta"
            android:textAllCaps="false"
            android:textColor="@color/clarys_light" />

        <Button
            android:id="@+id/buttonReportsFromDetail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary_button"
            android:backgroundTint="@null"
            android:text="Ver reportes"
            android:textAllCaps="false"
            android:textColor="@color/clarys_mid" />
    </LinearLayout>
</ScrollView>
