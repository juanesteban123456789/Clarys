<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonHeaderHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Ir al inicio"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_home"
                android:tint="@color/clarys_mid" />

            <ImageButton
                android:id="@+id/buttonHeaderBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Volver atrás"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/clarys_mid" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_hero"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:adjustViewBounds="true"
                android:contentDescription="Logo Clarys"
                android:src="@drawable/logo_taller_clarys" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_badge"
                android:drawableStart="@drawable/ic_store"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Acceso del taller"
                android:textColor="@color/clarys_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_login_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa como administrador"
                android:textColor="@color/clarys_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Administra inventario, productos, pedidos y configuración de tu taller."
                android:textColor="@color/clarys_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_input"
                android:hint="Correo del taller"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/clarys_text"
                android:textColorHint="@color/clarys_muted" />

            <EditText
                android:id="@+id/inputLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/clarys_text"
                android:textColorHint="@color/clarys_muted" />

            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_mail"
                android:drawablePadding="10dp"
                android:drawableTint="@color/clarys_light"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Ingresar con correo"
                android:textAllCaps="false"
                android:textColor="@color/clarys_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonGoogleLogin"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_google_button"
                    android:clickable="true"
                    android:contentDescription="Iniciar taller con Google"
                    android:drawablePadding="6dp"
                    android:drawableTop="@drawable/ic_google_color"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="10dp"
                    android:text="Google"
                    android:textColor="@color/clarys_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buttonRegisterAdmin"
                    android:layout_width="0dp"
                    android:layout_height="86dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_register_button"
                    android:clickable="true"
                    android:contentDescription="Registrar taller"
                    android:drawablePadding="6dp"
                    android:drawableTop="@drawable/ic_register"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="10dp"
                    android:text="Registrar taller"
                    android:textColor="@color/clarys_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
