<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clarys_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonHeaderHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Ir al inicio"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_home"
                android:tint="@color/clarys_mid" />

            <ImageButton
                android:id="@+id/buttonHeaderBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:backgroundTint="@null"
                android:contentDescription="Volver atrás"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/clarys_mid" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nueva venta"
            android:textColor="@color/clarys_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputSaleSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="Buscar producto"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <Button
            android:id="@+id/buttonSaleSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Buscar productos"
            android:textAllCaps="false"
            android:textColor="@color/clarys_light" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSaleProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Carrito de venta"
            android:textColor="@color/clarys_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSaleCart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                android:textColor="@color/clarys_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSaleCartTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/clarys_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputSaleCustomer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Cliente"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <EditText
            android:id="@+id/inputSalePhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Teléfono"
            android:inputType="phone"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <Spinner
            android:id="@+id/spinnerPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp" />

        <EditText
            android:id="@+id/inputSaleDiscount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Descuento"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/clarys_text"
            android:textColorHint="@color/clarys_muted" />

        <Button
            android:id="@+id/buttonConfirmSale"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Confirmar venta"
            android:textAllCaps="false"
            android:textColor="@color/clarys_light" />

        <Button
            android:id="@+id/buttonClearSaleCart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Vaciar carrito"
            android:textAllCaps="false"
            android:textColor="@color/clarys_light" />
    </LinearLayout>
</ScrollView>
