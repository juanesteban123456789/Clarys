<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_canvas"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scrollCatalog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/catalogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonHeaderBack"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_header_action"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/catalog_back"
                    android:padding="13dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/clarys_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/catalog_title"
                        android:textColor="@color/clarys_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/catalog_subtitle"
                        android:textColor="@color/clarys_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/buttonHeaderHome"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_header_action"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/catalog_home"
                    android:padding="13dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/clarys_mid" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="74dp"
                    android:layout_height="68dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/catalog_logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_taller_clarys" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/catalog_hero_title"
                        android:textColor="@color/clarys_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/catalog_hero_description"
                        android:textColor="@color/clarys_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputCatalogSearch"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/catalog_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:paddingHorizontal="15dp"
                    android:singleLine="true"
                    android:textColor="@color/clarys_text"
                    android:textColorHint="@color/clarys_muted"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonCatalogSearch"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_primary_button"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/catalog_search_action"
                    android:padding="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/clarys_light" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonCatalogHelp"
                    android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp"
                    android:src="@android:drawable/ic_menu_info_details" android:background="@drawable/bg_header_action"
                    android:contentDescription="Ayuda y privacidad" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonCatalogFilters"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:background="@drawable/bg_admin_action" android:backgroundTint="@null"
                    android:text="Filtros" android:textColor="@color/clarys_dark" android:textAllCaps="false"
                    app:drawableStartCompat="@drawable/ic_search" app:drawableTint="@color/clarys_dark"
                    android:paddingHorizontal="12dp" />
                <Spinner android:id="@+id/spinnerCatalogSort"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.4"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_input"
                    android:contentDescription="Ordenar productos" />
                <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/buttonCatalogFavorites"
                    android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
                    android:background="@drawable/bg_header_action" android:src="@android:drawable/btn_star_big_off"
                    android:contentDescription="Ver favoritos" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonGoToSale"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:text="@string/catalog_open_counter_sale"
                android:textAllCaps="false"
                android:textColor="@color/clarys_light"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/catalog_explore_categories"
                android:textColor="@color/clarys_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/catalog_swipe_categories"
                android:textColor="@color/clarys_muted"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerCategoryChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/containerCatalogSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/progressCatalog"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="34dp"
                android:indeterminateTint="@color/clarys_mid"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerCatalogResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textCatalogResultsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/clarys_dark"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textCatalogResultsCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/clarys_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/buttonBackToCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_category_chip"
                        android:clickable="true"
                        android:drawablePadding="5dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/catalog_categories"
                        android:textColor="@color/clarys_mid"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_arrow_back" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCatalogResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>

            <TextView
                android:id="@+id/textCatalogEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_soft_card"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/catalog_empty"
                android:textColor="@color/clarys_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonCatalogStateAction"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_action_client"
                android:backgroundTint="@null"
                android:minWidth="160dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAllCaps="false"
                android:textColor="@color/clarys_light"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_navigation"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <TextView
            android:id="@+id/buttonBottomCategories"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_navigation_active"
            android:clickable="true"
            android:contentDescription="@string/catalog_open_catalog"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/catalog_title"
            android:textColor="@color/clarys_light"
            android:textSize="11sp"
            android:textStyle="bold"
            app:drawableTint="@color/clarys_light"
            app:drawableTopCompat="@drawable/ic_store" />

        <TextView
            android:id="@+id/buttonBottomCart"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/catalog_open_cart"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/catalog_cart"
            android:textColor="@color/clarys_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            app:drawableTint="@color/clarys_muted"
            app:drawableTopCompat="@drawable/ic_cart" />

        <TextView
            android:id="@+id/buttonBottomOrders"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/catalog_open_orders"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/catalog_orders"
            android:textColor="@color/clarys_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            app:drawableTint="@color/clarys_muted"
            app:drawableTopCompat="@drawable/ic_report" />

        <TextView
            android:id="@+id/buttonBottomProfile"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="@string/catalog_return_admin_panel"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/catalog_admin_panel"
            android:textColor="@color/clarys_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableTint="@color/clarys_muted"
            app:drawableTopCompat="@drawable/ic_home" />
    </LinearLayout>
</LinearLayout>
