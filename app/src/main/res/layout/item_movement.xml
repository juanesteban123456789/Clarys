<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_soft_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textMovementTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/clarys_dark"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textMovementDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/clarys_mid" />

    <TextView
        android:id="@+id/textMovementReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/clarys_muted"
        android:textSize="13sp" />
</LinearLayout>
