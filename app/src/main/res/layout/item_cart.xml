<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_product_info_card"
    android:orientation="vertical"
    android:padding="16dp">


    <!-- ================================================= -->
    <!-- PRODUCTO -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/textCartName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="@color/clarys_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCartDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/clarys_muted"
        android:textSize="12sp" />


    <!-- ================================================= -->
    <!-- SEPARADOR -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:alpha="0.12"
        android:background="@color/clarys_muted" />


    <!-- ================================================= -->
    <!-- CANTIDAD + SUBTOTAL -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- CANTIDAD -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_stock_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">


            <!-- RESTAR -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonCartMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_admin_action"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="@color/clarys_mid"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- CANTIDAD ACTUAL -->

            <TextView
                android:id="@+id/textCartQuantity"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/clarys_dark"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- SUMAR -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonCartPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_admin_action"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/clarys_mid"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- SUBTOTAL -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtotal"
                android:textColor="@color/clarys_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCartSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:textColor="@color/clarys_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- QUITAR -->
    <!-- ================================================= -->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonCartRemove"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_soft_button"
        android:backgroundTint="@null"
        android:gravity="center"
        android:minHeight="0dp"
        android:text="Quitar del carrito"
        android:textAllCaps="false"
        android:textColor="@color/clarys_mid"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>