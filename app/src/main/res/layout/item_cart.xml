<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_soft_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textCartName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/clarys_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCartDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/clarys_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonCartMinus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="-"
            android:textColor="@color/clarys_light" />

        <TextView
            android:id="@+id/textCartQuantity"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/clarys_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonCartPlus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="+"
            android:textColor="@color/clarys_light" />

        <TextView
            android:id="@+id/textCartSubtotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/clarys_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonCartRemove"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_soft_button"
            android:backgroundTint="@null"
            android:text="Quitar"
            android:textAllCaps="false"
            android:textColor="@color/clarys_mid" />
    </LinearLayout>
</LinearLayout>
